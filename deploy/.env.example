############
# Domains — set these to YOUR real, externally-resolvable URLs.
#   APP      → where the Presio app is served (presio.example.com)
#   SUPABASE → where the Supabase API gateway (Kong) is served
#
# APP_HOST / SUPABASE_HOST are the BARE hostnames (no scheme) used by the
# Traefik proxy's Host() routing rules; they must match the host part of
# SITE_URL / SUPABASE_PUBLIC_URL below.
#
# IMPORTANT: SUPABASE_PUBLIC_URL is used both by the browser AND by the Presio
# server to build the public PDF URLs handed to viewers, so it MUST be a real
# domain that resolves from outside the stack. Plain `http://localhost:8000`
# only works for throwaway single-host testing.
#
# SERVING THE APP ON TWO DOMAINS (optional — leave the *_ALT vars empty for the
# ordinary one-domain setup):
#
#   The APP can be dual-homed. The API cannot. Several values here can only
#   hold one thing — VITE_SUPABASE_URL is baked into the client bundle at build
#   time, API_EXTERNAL_URL is what GoTrue builds OAuth redirects and email links
#   from, and an OAuth app has exactly one callback URL. So the API, auth,
#   storage and analytics all live on ONE domain, and the app answers on both.
#
#   Which domain gets the API matters: pick the one reachable from the most
#   restricted network you care about. A visitor on the second domain calling
#   the first one's API is an ordinary cross-origin request (ALLOWED_ORIGIN is a
#   list, and the CSP already permits it), but if the API host is the blocked
#   one, the second domain is broken for exactly the people it was added for.
#
#   Note the two domains do NOT share browser storage — local decks, the recents
#   list, controller layout, the auth session and the PWA install all belong to
#   one origin. A user who switches domains sees an empty Presio.
############
APP_HOST=presio.xyz
# Optional second hostname for the APP only. Empty = single-domain.
APP_HOST_ALT=
SUPABASE_HOST=supabase.presio.xyz
# Optional former API hostname, kept routed so cached service workers and
# installed PWAs still calling the old host don't hard-fail after a move.
SUPABASE_HOST_ALT=
SUPABASE_PUBLIC_URL=https://supabase.presio.xyz
API_EXTERNAL_URL=https://supabase.presio.xyz
SITE_URL=https://presio.xyz
# Public origins for generated links, comma-separated, in priority order.
# Leave empty to default to https://${APP_HOST}.
#
# A share or handoff link follows whichever of these domains the visitor
# actually used, so they get a link they can open. Canonical/og:url tags and
# the OpenAPI and JSON Schema self-references always use the FIRST entry, so
# the two domains don't compete as duplicate content.
#
# Dual-homed, list both: https://presio.ch,https://presio.xyz
PUBLIC_BASE_URLS=
# Optional viewer hostnames: where audiences watch (e.g. viewer.presio.xyz),
# paired in order with the app hostnames above (VIEWER_HOST with APP_HOST,
# VIEWER_HOST_ALT with APP_HOST_ALT). A separate origin keeps the presenter's
# plugins, which run on every audience device, away from what Presio stores in
# an audience member's browser for the app origin (their login, their own
# decks' controller tokens). Needs its own DNS record; the *.domain origin
# certificates already cover it. Empty = viewers use the app hostnames.
VIEWER_HOST=
VIEWER_HOST_ALT=
# Comma-separated extra OAuth redirect targets (include localhost for dev).
# Wildcards matter: OAuth logins pass the user's current page (e.g.
# /s/ABC123?role=controller) as the redirect target, and GoTrue falls back to
# SITE_URL (the home page) for any URL not matched by this list.
ADDITIONAL_REDIRECT_URLS=https://presio.xyz/**,https://staging.presio.xyz/**,http://localhost:5173/**

# One-time code length in auth emails (GoTrue caps this at 10).
MAILER_OTP_LENGTH=10

# Browsers send an Origin header even on same-origin fetch/WebSocket requests,
# so this must be set to the app URL. Only add extra origins (comma-separated)
# if the client is hosted on a separate domain — or if the app is served from
# two domains, in which case list both.
ALLOWED_ORIGIN=https://presio.xyz
# URL of the Umami instance — added to the script-src CSP so the tracking
# script is allowed to load. Leave empty to disable. Umami itself is not in
# this stack: it runs host-wide next to the proxy (see deploy/README.md).
#
# This must match the host client/index.html loads the tracking script from: the
# CSP script-src is derived from it, so a mismatch blocks analytics silently.
ANALYTICS_URL=https://analytics.presio.xyz

############
# Observability
# - SENTRY_DSN / VITE_SENTRY_DSN: error tracking for the server and client.
#   Point them at Sentry's SaaS or a self-hosted GlitchTip. Leave empty to
#   disable. VITE_SENTRY_DSN is baked into the client bundle at build time.
# - Uptime monitoring (Uptime Kuma) runs host-wide, not in this stack; point
#   a monitor at https://${APP_HOST}/healthz (see deploy/README.md).
############
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

############
# Core secrets — CHANGE ALL OF THESE
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy HS256 API keys derived from JWT_SECRET (see the generate-keys helper).
# ANON_KEY is also used as the client's VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY.
ANON_KEY=paste-the-generated-anon-key-here
SERVICE_ROLE_KEY=paste-the-generated-service-role-key-here

# Opaque (sb_publishable_/sb_secret_) keys — optional, leave blank to use the
# legacy keys above.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Supabase Studio dashboard login (https://supabase.example.com).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-this-dashboard-password

# Used internally by Studio-meta — change this too.
PG_META_CRYPTO_KEY=change-this-encryption-key-32-chars-min

############
# Auth — GitHub OAuth + email/password
#
# Register a GitHub OAuth App with callback:
#   ${API_EXTERNAL_URL}/auth/v1/callback
# i.e. https://supabase.example.com/auth/v1/callback
############
GITHUB_ENABLED=true
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

# Email/password signup. Set AUTOCONFIRM=true to skip email verification (no
# SMTP needed); set false and configure SMTP_* for real confirmation emails.
ENABLE_EMAIL_SIGNUP=true
# false = signups must confirm via email; requires working SMTP_* below
# (e.g. Resend: host smtp.resend.com, port 465, user "resend", pass = API key).
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
SMTP_ADMIN_EMAIL=admin@presio.xyz
SMTP_HOST=smtp.presio.xyz
SMTP_PORT=2500
SMTP_USER=noreply@presio.xyz
SMTP_PASS=noreply@presio.xyz
SMTP_SENDER_NAME=Presio
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Phone auth — unused by Presio, left at upstream defaults.
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage (MinIO-backed). GLOBAL_S3_BUCKET is the single MinIO bucket that
# holds all objects; the logical "presentations" bucket lives inside it and is
# created by dbschema.sql.
############
MINIO_ROOT_USER=presio-storage
MINIO_ROOT_PASSWORD=change-this-minio-password
GLOBAL_S3_BUCKET=presio-storage
REGION=us-east-1
STORAGE_TENANT_ID=presio
# S3 protocol endpoint creds (Supabase's own S3 API; unused by Presio but the
# storage service still reads them).
S3_PROTOCOL_ACCESS_KEY_ID=change-this-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=change-this-access-key-secret

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Studio dashboard
############
STUDIO_DEFAULT_ORGANIZATION=Presio
STUDIO_DEFAULT_PROJECT=Presio
OPENAI_API_KEY=

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# API gateway
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

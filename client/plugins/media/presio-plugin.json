{
  "$schema": "https://presio.ch/schema/plugin-manifest.schema.json",
  "presio": 1,
  "name": "media",
  "displayName": "Media",
  "version": "1.0.0",
  "author": "Presio",
  "description": "Plays the GIFs, videos and YouTube/Vimeo embeds in your PDF on their slides, in sync on every screen, with play, restart and audio controls on your current slide.",
  "main": "index.html",
  "surfaces": ["background", "slide"],
  "activation": ["attachment:media-slide-*.json"],
  "permissions": ["deck"],
  "contributes": {
    "commands": [{ "id": "togglePlay", "title": "Play/pause media" }, { "id": "restart", "title": "Restart media" }],
    "keybindings": [
      { "command": "togglePlay", "keys": [{ "key": "k" }] },
      { "command": "restart", "keys": [{ "key": "r" }] }
    ]
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    // No outDir on purpose. Nothing emits from this config — CI and the
    // pre-commit hook run tsc --noEmit, and npm start runs tsx — and setting
    // one makes TypeScript 7 enforce rootDir containment, which e2eHarness.ts
    // breaks by importing ../e2e/constants.ts.
    "skipLibCheck": true
  },
  // Every module, not just the entry points: a file nothing imports yet
  // (a new route, a helper) is still checked.
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
